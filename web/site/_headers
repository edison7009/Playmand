# Cloudflare Pages: cache the built WebAssembly and art for a day; the page
# itself is always revalidated so a new build shows up straight away.
/pkg/*
  Cache-Control: public, max-age=86400
/pkg-harbor/*
  Cache-Control: public, max-age=86400
/art/*
  Cache-Control: public, max-age=86400
/
  Cache-Control: no-cache
/zh/
  Cache-Control: no-cache
